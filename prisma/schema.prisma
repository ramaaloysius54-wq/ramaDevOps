generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CS
}

enum ConnectionStatus {
  DISCONNECTED
  CONNECTING
  QR_READY
  PAIRING_CODE_READY
  CONNECTED
  RECONNECTING
}

enum MessageSenderType {
  CUSTOMER
  BOT
  AGENT
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  LOCATION
  STICKER
}

enum MessageDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum OrderStatus {
  PENDING
  WAITING_PAYMENT
  PAID
  PROCESSING
  COMPLETED
  CANCELLED
}

enum ProductCategoryType {
  APLIKASI_PREMIUM
  JASA_WEBSITE
  JASA_BOT_WA
  LAINNYA
}

enum KeywordMatchType {
  EXACT
  CONTAINS
  REGEX
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  password      String
  role          Role           @default(ADMIN)
  avatarUrl     String?
  phone         String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  auditLogs     AuditLog[]

  @@index([email])
}

model WhatsAppSession {
  id        String   @id @default("default-session")
  sessionId String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsappConnection {
  id             String           @id @default(uuid())
  sessionId      String           @unique @default("primary")
  phone          String?
  pushName       String?
  status         ConnectionStatus @default(DISCONNECTED)
  qrCode         String?          @db.Text
  pairingCode    String?
  uptimeStart    DateTime?
  lastActive     DateTime?
  messagesSent   Int              @default(0)
  messagesRecv   Int              @default(0)
  reconnectCount Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Customer {
  id            String         @id @default(uuid())
  phone         String         @unique
  name          String
  email         String?
  tags          String[]       @default(["NEW"])
  notes         String?        @db.Text
  isBlocked     Boolean        @default(false)
  profilePicUrl String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  orders        Order[]

  @@index([phone])
}

model Conversation {
  id              String        @id @default(uuid())
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedAgentId String?
  assignedAgent   User?         @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  isBotActive     Boolean       @default(true)
  isArchived      Boolean       @default(false)
  isPinned        Boolean       @default(false)
  unreadCount     Int           @default(0)
  lastMessageAt   DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  messages        Message[]

  @@index([customerId])
  @@index([lastMessageAt])
}

model Message {
  id             String                @id @default(uuid())
  conversationId String
  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     MessageSenderType
  senderId       String?
  type           MessageType           @default(TEXT)
  content        String                @db.Text
  mediaUrl       String?
  status         MessageDeliveryStatus @default(PENDING)
  waMessageId    String?               @unique
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([conversationId])
  @@index([createdAt])
}

model Product {
  id          String              @id @default(uuid())
  sku         String              @unique
  name        String
  description String              @db.Text
  price       Decimal             @db.Decimal(12, 2)
  promoPrice  Decimal?            @db.Decimal(12, 2)
  stock       Int                 @default(0)
  category    ProductCategoryType
  imageUrl    String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  orderItems  OrderItem[]

  @@index([sku])
  @@index([category])
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(12, 2)
  discount        Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  paymentMethod   String?
  paymentProofUrl String?
  trackingNumber  String?
  customerNotes   String?     @db.Text
  internalNotes   String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([orderNumber])
  @@index([status])
  @@index([customerId])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int      @default(1)
  subtotal    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model BotCommand {
  id          String   @id @default(uuid())
  command     String   @unique
  description String
  response    String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BotKeyword {
  id        String           @id @default(uuid())
  keyword   String           @unique
  matchType KeywordMatchType @default(CONTAINS)
  response  String           @db.Text
  isActive  Boolean          @default(true)
  priority  Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([keyword])
}

model ServerMetric {
  id              String   @id @default(uuid())
  cpuUsage        Float
  cpuCores        Int
  cpuLoadAvg      Float
  ramTotalBytes   BigInt
  ramUsedBytes    BigInt
  ramFreeBytes    BigInt
  ramUsagePercent Float
  botMemoryRss    BigInt
  botMemoryHeap   BigInt
  recordedAt      DateTime @default(now())

  @@index([recordedAt])
}

model BotLog {
  id        String   @id @default(uuid())
  level     String   @default("INFO")
  category  String
  message   String   @db.Text
  context   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String   @db.Text
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  payload   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PaymentConfig {
  id         String   @id @default("default-payment")
  gopay      String   @default("088227142563")
  qrisBase64 String?  @db.Text
  updatedAt  DateTime @updatedAt
}

model BotConfig {
  id                     String   @id @default("default-config")
  isEnabled              Boolean  @default(true)
  isAutoRejectCalls      Boolean  @default(true)
  botName                String   @default("Rama Store Bot")
  prefix                 String   @default("!")
  welcomeMessage         String   @db.Text
  outOfOfficeMessage     String   @db.Text
  fallbackMessage        String   @db.Text
  adminPhoneNotification String?
  operatingHourStart     String   @default("08:00")
  operatingHourEnd       String   @default("21:00")
  isOperatingHoursActive Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
